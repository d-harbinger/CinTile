{
    "head-keybinding": {
        "type": "header",
        "description": "Keybinding"
    },
    "keybinding": {
        "type": "keybinding",
        "default": "<Super>t",
        "description": "Show tile grid"
    },

    "sep-grid": {
        "type": "separator"
    },
    "head-grid": {
        "type": "header",
        "description": "Grid Layout"
    },
    "grid-widget": {
        "type": "custom",
        "file": "GridWidget.py",
        "widget": "GridWidget",
        "description": "Visual grid editor",
        "default": ""
    },

    "sep-appearance": {
        "type": "separator"
    },
    "head-appearance": {
        "type": "header",
        "description": "Appearance"
    },
    "window-gap": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 50,
        "step": 2,
        "units": "pixels",
        "description": "Gap between windows",
        "tooltip": "Pixel gap between tiled windows (0 = no gap)"
    },
    "grid-opacity": {
        "type": "scale",
        "default": 80,
        "min": 20,
        "max": 100,
        "step": 5,
        "description": "Grid overlay opacity (%)",
        "tooltip": "How opaque the grid overlay appears"
    },
    "grid-color": {
        "type": "colorchooser",
        "default": "rgba(74, 144, 217, 0.3)",
        "description": "Grid cell color",
        "tooltip": "Background color of unselected grid cells"
    },
    "highlight-color": {
        "type": "colorchooser",
        "default": "rgba(255, 200, 0, 0.6)",
        "description": "Selected cell highlight color",
        "tooltip": "Background color when a cell is selected as the first tile"
    },

    "sep-advanced": {
        "type": "separator"
    },
    "head-advanced": {
        "type": "header",
        "description": "Advanced — Grid Dimensions & Weights"
    },
    "grid-cols": {
        "type": "spinbutton",
        "default": 4,
        "min": 2,
        "max": 7,
        "step": 1,
        "units": "columns",
        "description": "Number of grid columns",
        "tooltip": "Also controllable via the visual editor above"
    },
    "grid-rows": {
        "type": "spinbutton",
        "default": 2,
        "min": 2,
        "max": 5,
        "step": 1,
        "units": "rows",
        "description": "Number of grid rows",
        "tooltip": "Also controllable via the visual editor above"
    },
    "col-0-weight": {
        "type": "spinbutton",
        "default": 1,
        "min": 0,
        "max": 10,
        "step": 1,
        "description": "Column 1 weight",
        "tooltip": "Relative width (0 = hidden)"
    },
    "col-1-weight": {
