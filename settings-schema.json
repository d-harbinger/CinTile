{
    "head-keybinding": {
        "type": "header",
        "description": "Keybinding"
    },
    "keybinding": {
        "type": "keybinding",
        "default": "<Super>t",
        "description": "Show tile grid"
    },

    "sep1": {
        "type": "separator"
    },
    "head-grid": {
        "type": "header",
        "description": "Grid Dimensions"
    },
    "grid-cols": {
        "type": "spinbutton",
        "default": 4,
        "min": 2,
        "max": 7,
        "step": 1,
        "units": "columns",
        "description": "Number of grid columns",
        "tooltip": "How many columns the grid has (2–7)"
    },
    "grid-rows": {
        "type": "spinbutton",
        "default": 2,
        "min": 2,
        "max": 5,
        "step": 1,
        "units": "rows",
        "description": "Number of grid rows",
        "tooltip": "How many rows the grid has (2–5)"
    },

